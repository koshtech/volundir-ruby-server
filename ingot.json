{
  "name": "volundir-ruby-server",
  "version": "0.0.1",
  "description": "[:Volundir][:Ruby][:Server] is a minimal Back End Server for [:Volundir][:PWA].",
  "dependencies": ["volundir-ruby"],
  "install": {
    "pre_install": {
      "directories": []
    },
    "post_install": {
      "copy": [
        {
          "source": "support/.volundir-ruby-server.development.env",
          "destination": ".volundir-ruby.development.env"
        },
        {
          "source": "support/Gemfile.inc.rb",
          "destination": "Gemfile.inc.volundir-ruby-server.rb"
        }
      ],
      "symlinks": [],
      "permissions": ["bin/volundir_ruby.rb"]
    }
  },
  "comands": [
    {
      "name": "server",
      "aliases": ["s"],
      "description": "Starts the application server",
      "action": "start_server",
      "const_name": "Volundir::Server::BackEnd",
      "controller": "/server/back_end.rb"
    }
  ],
  "apps": [
    {
      "name": "back_end",
      "assets": false,
      "controllers": true,
      "helpers": false,
      "models": false,
      "views": false
    }
  ]
}
